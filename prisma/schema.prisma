datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // CERTTPL+.4.1 (30.08.2026, за прямим проханням користувача) — Supabase
  // pgbouncer (transaction mode, `DATABASE_URL`) не підтримує advisory
  // locks/prepared statements, потрібні `prisma migrate`, тому окреме
  // пряме з'єднання (порт 5432, без пулера) лише для `migrate deploy`/
  // `migrate dev`/`db push`. Звичайні рантайм-запити застосунку й далі
  // йдуть через `url` (pooler) без жодних змін — Prisma сама перемикає
  // з'єднання залежно від команди, нічого руками перемикати не треба.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  firstName          String
  lastName           String?
  nickname           String?
  avatarUrl          String?
  about              String?
  homeworkVisible    Boolean   @default(true)
  role               String    @default("USER") // "USER" | "ADMIN"
  // ADMIN+.1 (09.08.2026). Аудит останньої зміни ролі — ХТО (текстовий
  // знімок "Ім'я Прізвище (email)" на момент дії, а НЕ FK на User: якщо
  // того адміна згодом видалять (F.24, реальне видалення акаунта),
  // запис лишається читабельним замість перетворення на "хтось видалений"
  // чи каскадного стирання самого сліду зміни) і КОЛИ. NULL для всіх,
  // чию роль ще ніколи не змінювали вручну через /admin/users (включно з
  // тими, хто отримав ADMIN одразу через prisma/seed.ts).
  roleChangedByLabel String?
  roleChangedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments         Enrollment[]
  progress            Progress[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  pointsLedger        PointsLedger[]
  homeworkSubmissions HomeworkSubmission[]
  certificates        Certificate[]
  // ФАЗА PAID+, задача PAID+.0.3 — див. докблок над `Course.purchases`.
  purchases           CoursePurchase[]
  // ФАЗА MSG+, задача MSG+.0.1 — див. докблок над `ConversationParticipant`.
  conversationMemberships ConversationParticipant[]
  // ФАЗА MSG+, задача MSG+.0.2 — див. докблок над `Message`. `onDelete:
  // SetNull` (не Cascade): при реальному видаленні акаунта (F.24)
  // повідомлення НЕ зникають — лишаються в розмові, `senderId` стає
  // NULL, а `senderLabel` (заповнюється інтеграцією F.24↔MSG+.5.1,
  // `modules/account/service.ts`) лишається текстовим знімком.
  sentMessages            Message[]
  // ФАЗА MSG+, задача MSG+.4.1 — див. докблок над `UserBlock`. Дві
  // сторони одного зв'язку: хто заблокував (`blockerId`) і кого
  // заблокували (`blockedId`) — окремі relation-и, бо це один і той
  // самий `User` з обох боків FK.
  blockedUsers            UserBlock[] @relation("BlockerUser")
  blockedByUsers          UserBlock[] @relation("BlockedUser")
  // ФАЗА MSG+, задача MSG+.4.1 — див. докблок над `MessageReport`.
  // `onDelete: SetNull` (та сама причина, що й `Message.senderId`,
  // MSG+.5.1): скарга — доказ для модерації, лишається читабельною
  // (`reporterLabel`-знімок) навіть якщо автор скарги видалив акаунт.
  messageReports          MessageReport[]
  // ФАЗА MSG+, задача MSG+.4.2 — див. докблок над
  // `ConversationModerationLog`. `onDelete: SetNull` — аудит-слід
  // перегляду лишається (`adminLabel`-знімок), навіть якщо той адмін
  // згодом видалить свій акаунт.
  moderationLogs          ConversationModerationLog[]
}

model PendingRegistration {
  // F.26 (27.08.2026). Незавершена реєстрація — юзер ще НЕ підтвердив
  // email кодом, тому реального запису User для нього ще немає.
  // Навмисно ОКРЕМА модель, а не поле на User (User тут в принципі не
  // існує) і навмисно НЕ stateless JWT (як passwordResetToken/
  // emailChangeToken) — бо потрібно рахувати невдалі спроби вводу коду
  // (attempts) і дозволяти "надіслати ще раз", а це вимагає стану, який
  // переживає рестарт сервера/serverless-інстансу (на відміну від
  // in-memory throttle-мапи в lib/auth/rateLimit.ts, тут втрата запису
  // означала б, що юзер, який щойно ввів правильний код, "не існує").
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String?
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Course {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  description      String
  coverImage       String?
  published        Boolean  @default(false)
  introVideoUrl    String?
  introDescription String?
  // Поля майстра/інструктора курсу (задача 3.11, доповнення 24.07.2026 —
  // за прямим проханням користувача). Усі опційні: якщо адмін їх не
  // заповнив, `MasterSection` на лендінгу лишається на статичному фолбеку
  // (той самий "містячий" патерн за наявністю даних, що вже застосований
  // для Hero-опису курсу). Одне поле "майстер" на курс, а не окрема
  // модель `Instructor`, — свідоме спрощення: наразі на сайті один курс з
  // однією авторкою, окрема модель була б передчасною абстракцією.
  masterName       String?
  masterBio        String?
  masterAvatarUrl  String?
  // Заголовок і пункти-переваги секції "Про курс" на лендінгу (задача
  // HOME+.0.2) — доповнюють уже наявні `introVideoUrl`/`introDescription`.
  // `introHighlights` — Postgres-масив рядків, редагується єдиним блоком
  // в адмінці (`CourseForm`), без окремої таблиці.
  introTitle       String?
  introHighlights  String[] @default([])
  // CERTTPL+.0.1 (30.08.2026) — власний макет сертифіката курсу, за
  // прямим проханням користувача ("щоб в адмінці після створення курсу
  // можна було додавати завантажити зображення сертифікату"). Cloudinary
  // URL опційний — `NULL`, доки адмін нічого не завантажив. Немає
  // окремого поля `certificateImagePublicId` (на відміну від
  // `Certificate.imagePublicId` для CERT+): `public_id` тут завжди
  // стабільно виводиться з `Course.id`
  // (`certificate-templates/{courseId}`, `lib/storage/
  // certificateTemplateStorage.ts`), тому зберігати його окремо не
  // потрібно — той самий принцип, що вже в `coverImage`/`courseCoverStorage.ts`
  // (публічний `public_id` теж не зберігається окремим полем).
  certificateImage String?
  // ФАЗА CAT+, задача CAT+.0.1 (01.09.2026, за прямим проханням
  // користувача — "щоб при створенні курсів можна було вказувати
  // декілька категорій"). Той самий підхід, що вже `introHighlights`
  // вище: простий Postgres-масив рядків на самій моделі `Course`,
  // без окремої таблиці/enum — адмін обирає з готового набору пресетів
  // (`COURSE_CATEGORY_PRESETS`, `modules/courses/schema.ts`) І/АБО
  // додає власну довільну категорію текстом; обидва варіанти
  // зберігаються як прості рядки в одному масиві — на рівні БД різниці
  // немає. `String[]`, а не enum: enum заборонив би "свою власну
  // категорію" з прямого прохання користувача.
  categories       String[] @default([])
  // ФАЗА PAID+, задача PAID+.0.1 (02.09.2026, за прямим проханням
  // користувача — "зроби щоб можна було при створенні чи редагуванні
  // курсу вибирати безкоштовний чи платний курс"). Той самий принцип
  // простого прапорця на моделі `Course`, що вже `published` вище:
  // `isPaid = false` — курс поводиться ТОЧНО як зараз (без жодних змін
  // доступу). `isPaid = true` — курс за замовчуванням НЕДОСТУПНИЙ для
  // студентів (`modules/access::hasCourseAccess`, задача PAID+.1.1),
  // доки не буде підключено реальну оплату (ФАЗА PAID+.4, окрема
  // наступна фаза — сюди НЕ входить).
  isPaid           Boolean  @default(false)
  // Ціна в цілих гривнях (без копійок — свідоме спрощення, той самий
  // рівень деталізації, що вже прийнятий у проєкті для інших полів;
  // якщо колись знадобляться копійки — окрема міграція на `Decimal`).
  // `NULL`, доки `isPaid = false`; адмінська форма скидає це поле в
  // `NULL` при вимкненні перемикача "Платний курс"
  // (`modules/courses/actions.ts::readCourseFormFields`).
  priceUAH         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  certificates Certificate[]
  featuredBy   SiteSettings?
  // ФАЗА PAID+, задача PAID+.0.3 — записи покупок цього курсу. Модель
  // `CoursePurchase` існує в схемі вже зараз (задля єдиної міграції
  // базових полів курсу — `isPaid`/`priceUAH` — і структури покупки
  // разом, без повторної міграції пізніше), але РЕАЛЬНО не заповнюється
  // жодним кодом, доки не підключено платіжного провайдера (ФАЗА
  // PAID+.4). До того часу `hasCourseAccess` (PAID+.1.1) просто ніколи
  // не знаходить `COMPLETED`-запису — платний курс лишається
  // недоступним, що і є задуманою поведінкою "за замовчуванням".
  purchases   CoursePurchase[]
}

// Сайтові налаштування — однорядкова (singleton) таблиця (задача
// HOME+.0.1). Наразі містить лише вибір "курсу на головній сторінці"
// (featured course, задача 0.20/HOME+), реальне server-side збереження
// замість попереднього `localStorage`-proof-of-concept
// (`lib/progress/localFeaturedCourse.ts`, прибрано в HOME+.7).
model SiteSettings {
  id               String   @id @default("singleton")
  featuredCourseId String?  @unique
  featuredCourse   Course?  @relation(fields: [featuredCourseId], references: [id], onDelete: SetNull)
  updatedAt        DateTime @updatedAt
}

model Lesson {
  id            String   @id @default(uuid())
  courseId      String
  order         Int
  title         String
  duration      String?
  videoProvider String   @default("YOUTUBE") // "YOUTUBE" | "CUSTOM"
  videoUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  article             Article?
  quiz                Quiz?
  progress            Progress[]
  comments            Comment[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkAssignment  HomeworkAssignment?

  @@index([courseId, order])
}

model Article {
  id          String   @id @default(uuid())
  lessonId    String   @unique
  contentJson String
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ФАЗА HW+, задача HW+.0.1 (28.08.2026) — ОКРЕМА від `HomeworkSubmission`
// (нижче): це опис завдання, який пише АДМІН для уроку (текст + відео-
// інструкція), не здача студентом свого відео у відповідь. Один опис на
// урок (`lessonId @unique`, той самий принцип, що `Article.lessonId`/
// `Quiz.lessonId`). `contentJson`/`videoUrl` — обидва `String?` (не
// `String` з порожнім рядком за замовчуванням), щоб "нічого не задано"
// відрізнялося від "задано порожній текст" на рівні типів.
model HomeworkAssignment {
  id          String   @id @default(uuid())
  lessonId    String   @unique
  contentJson String?
  videoUrl    String?
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String   @id @default(uuid())
  lessonId  String   @unique
  createdAt DateTime @default(now())

  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id       String  @id @default(uuid())
  quizId   String
  order    Int
  type     String  @default("TEXT") // "TEXT" | "IMAGE"
  text     String
  imageUrl String?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String  @id @default(uuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ФАЗА PAID+, задача PAID+.0.3 (02.09.2026, за прямим проханням
// користувача). Запис однієї спроби купівлі платного курсу. НАВМИСНО
// окрема модель від `Enrollment` (вище) — `Enrollment` лишається тим,
// чим і був (службовий запис "юзер бачить цей курс у Моєму навчанні",
// задача 7.10, не гейт доступу), а `CoursePurchase` — єдине джерело
// істини для "чи юзер реально заплатив за платний курс"
// (`modules/access::hasCourseAccess`, PAID+.1.1). РЕАЛЬНО не
// заповнюється жодним кодом до ФАЗИ PAID+.4 (підключення платіжного
// провайдера) — модель додана зараз лише щоб не робити другу міграцію
// базових полів курсу пізніше.
enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model CoursePurchase {
  id       String @id @default(uuid())
  userId   String
  courseId String

  status PurchaseStatus @default(PENDING)
  // Ціна курсу НА МОМЕНТ покупки (копія `Course.priceUAH`, а не
  // посилання) — щоб майбутня зміна ціни курсу адміном не переписувала
  // заднім числом суму вже здійсненої покупки.
  amountUAH Int
  provider  String
  // Власний ідемпотентний ідентифікатор замовлення, який генерується
  // ДО відправки запиту платіжному провайдеру і передається йому —
  // джерело істини для ідемпотентної обробки вебхук-ретраїв (той самий
  // принцип, що вже `@@unique([userId, courseId])` на `Enrollment` для
  // `ensureEnrollment`, задача 7.10), а НЕ `providerPaymentId` нижче
  // (він стає відомим лише вже ПІСЛЯ відповіді провайдера).
  providerOrderId   String  @unique
  providerPaymentId String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Швидка перевірка "чи є в юзера COMPLETED-покупка цього курсу" в
  // `hasCourseAccess` (PAID+.1.1) без повного сканування таблиці.
  @@index([userId, courseId, status])
}

model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  quizScore   Int?
  quizTotal   Int?
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Comment {
  id        String   @id @default(uuid())
  lessonId  String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([lessonId])
  @@index([parentId])
}

model CommentReaction {
  id        String @id @default(uuid())
  commentId String
  userId    String
  type      String // "LIKE" | "DISLIKE"

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String // "LESSON_COMPLETED" | "COURSE_COMPLETED"
  lessonId  String?
  courseId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, amount])
}

model HomeworkSubmission {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  videoUrl  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// `Certificate` (Фаза "Fixes", модуль `modules/certificates`) — реальна
// видача сертифіката, автоматично при завершенні ВСІХ уроків курсу (той
// самий тригер, що вже нараховує +5 балів за курс — `awardCoursePoints`,
// `modules/quizzes/actions.ts` → `submitQuizResultAction`). Один сертифікат
// на пару (userId, courseId) — `@@unique`, повторне завершення (неможливе
// логічно, але про всяк випадок) не плодить дублікати.
// ФАЗА CERT+, задача CERT+.0.1 (08.08.2026). Перший enum у схемі —
// розрізняє системно видані сертифікати (`SYSTEM`, наявна поведінка —
// завжди прив'язані до курсу, рендеряться як стилізований SVG-"папір")
// від власних завантажень користувача (`UPLOADED`, без курсу, з
// реальним фото). Перевірка "яке поле є для якого джерела" — НЕ
// БД-constraint (щоб не ускладнювати міграцію), а в
// `modules/certificates/service.ts`, той самий принцип, що решта
// бізнес-правил проєкту (валідація в сервісному шарі, не в БД).
enum CertificateSource {
  SYSTEM
  UPLOADED
}

model Certificate {
  id        String            @id @default(uuid())
  userId    String
  // ФАЗА CERT+, CERT+.0.1: зроблено НЕобов'язковим — для `UPLOADED`
  // курсу немає. `@@unique([userId, courseId])` нижче НЕ чіпається:
  // у Postgres кілька рядків з `courseId = NULL` не конфліктують між
  // собою (NULL ≠ NULL в unique-індексі), тож кілька
  // `UPLOADED`-сертифікатів одного юзера без курсу вже коректно
  // допустимі без зміни обмеження.
  courseId  String?
  issuedAt  DateTime          @default(now())
  source    CertificateSource @default(SYSTEM)
  /// Довільна назва, яку вводить сам користувач при завантаженні (CERT+.0.5). NULL для `SYSTEM` (там і далі використовується `course.title`).
  title     String?
  /// Cloudinary URL фото. NULL для `SYSTEM` (там рендериться SVG-"папір", не фото).
  imageUrl  String?
  /// Cloudinary `public_id` — потрібен для видалення файлу (CERT+.1.3/IMG+.3.4). NULL для `SYSTEM`.
  imagePublicId String?
  /// ФАЗА IMG+, IMG+.3.3 — метадані обробленого Sharp-pipeline зображення, лише для `UPLOADED`.
  width     Int?
  height    Int?
  sizeBytes Int?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ФАЗА MSG+, задача MSG+.0.1 (03.09.2026, за прямим проханням
// користувача — лише схема, без модулів/UI). Приватна розмова між
// користувачами. НАВМИСНО без прямих `userAId`/`userBId` на самій
// моделі — окрема `ConversationParticipant` про запас під майбутні
// групові розмови (MSG+.6, свідомо поза межами MVP), хоча на рівні
// сервісу (MSG+.1, наступна задача, не входить у цю міграцію)
// кількість учасників обмежується до 2, а `findOrCreateConversation`
// перевикористовує наявну розмову між тими самими двома юзерами
// замість створення дубліката.
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  reports         MessageReport[]
  moderationLogs  ConversationModerationLog[]
}

// Членство юзера в розмові + курсор прочитаного (MSG+.0.1). `lastReadAt`
// — єдине джерело істини для лічильника непрочитаних (`listConversationsForUser`,
// MSG+.1.1 — рахує `Message`, де `createdAt > lastReadAt` і `senderId != userId`),
// НАВМИСНО без окремого `readAt` на кожному `Message` — оновлення одного
// рядка `ConversationParticipant` при "позначити прочитаним" дешевше й
// простіше, ніж масове оновлення N рядків повідомлень.
model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Не дозволяє дублювати членство того самого юзера в тій самій розмові;
  // також те, на що спирається `findOrCreateConversation` (MSG+.1.1) для
  // пошуку наявної розмови між двома конкретними юзерами.
  @@unique([conversationId, userId])
  // Швидкий список розмов конкретного юзера (`listConversationsForUser`).
  @@index([userId])
}

// Повідомлення в приватній розмові (MSG+.0.2). Довжина `body` НЕ
// обмежується на рівні БД (Zod-валідація в `modules/messages/service.ts`,
// MSG+.1.2, не входить у цю міграцію) — той самий підхід, що вже
// `CertificateSource`-перевірка полів у `modules/certificates/service.ts`:
// бізнес-правила в сервісному шарі, не БД-constraint.
model Message {
  id             String   @id @default(uuid())
  conversationId String
  // Nullable + `onDelete: SetNull` (не Cascade) — рішення MSG+.5.1
  // (03.09.2026): при реальному видаленні акаунта (F.24) повідомлення
  // видаленого юзера лишаються в розмові, а не зникають разом з ним.
  senderId String?
  // Текстовий знімок імені відправника, за аналогією з
  // `User.roleChangedByLabel` — NULL, поки userId живий (ім'я береться
  // через `sender`-релейшн); заповнюється значенням "Видалений
  // користувач" інтеграцією F.24↔MSG+.5.1
  // (`modules/account/service.ts`, `anonymizeSenderForDeletedUser`,
  // 04.09.2026) у момент видалення акаунта, ПЕРЕД тим як `senderId`
  // стане NULL. Коли `senderId IS NULL` і `senderLabel IS NULL`
  // (гіпотетичний краш-кейс поза нормальним флоу) — UI показує той
  // самий дефолтний напис "Видалений користувач" (`displayName`,
  // `app/messages/**`).
  senderLabel String?
  body        String
  createdAt   DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  // Пагінація історії розмови курсором по `createdAt` (MSG+.1.1
  // `listMessages`), не offset — історія розмови може вирости.
  @@index([conversationId, createdAt])

  reports MessageReport[]
}

// Блокування одного юзера іншим (MSG+.4.1, рішення 03.09.2026):
// заблокований `blockedId` не може почати нову розмову з `blockerId` і
// не може писати в наявну (перевірка — `modules/messages/service.ts`,
// `assertNotBlocked`, в ОБИДВА боки: розмова "мовчить" для обох, а не
// лише для того, хто заблокував). Розмова й історія повідомлень НЕ
// видаляються при блокуванні — той самий принцип, що вже MSG+.5.1
// (видалення акаунта): блокування ховає можливість ПИСАТИ, не сам факт
// спілкування, що вже відбулось (може знадобитись для розгляду скарги,
// MSG+.4.2). `onDelete: Cascade` на обох FK (не SetNull, як у
// `Message.senderId`) — сам запис блокування без живих `blockerId`/
// `blockedId` не має сенсу (на відміну від тексту повідомлення, тут
// нема що "лишати читабельним" знімком).
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  // Не дозволяє задублювати той самий напрямок блокування; також те, на
  // що спирається "чи заблокував Х юзера Y" в `modules/messages/repository.ts`.
  @@unique([blockerId, blockedId])
  // Швидка перевірка "чи мене хтось заблокував" (протилежний напрямок
  // від `@@unique` вище — той самий `findBlockBetween`, MSG+.4.1,
  // перевіряє обидва напрямки окремими умовами `OR`).
  @@index([blockedId])
}

// Скарга на повідомлення (MSG+.4.1, рішення 03.09.2026): кнопка
// "поскаржитись" на чужому повідомленні. `messageBodySnapshot`/
// `messageSenderLabel` — текстовий знімок повідомлення НА МОМЕНТ скарги
// (той самий принцип, що `senderLabel` на `Message`), а не жива посилка
// на `Message.body` — повідомлення технічно можна відредагувати чи
// (гіпотетично, поза MVP) видалити пізніше, скарга має лишитись доказом
// того, що саме бачив скаржник. `reporterId` nullable + `reporterLabel`
// — той самий F.24-патерн, що `Message.senderId`/`senderLabel`: якщо
// автор скарги видалить акаунт, сама скарга (доказ для адмін-черги) не
// повинна зникнути чи стати нечитабельною.
model MessageReport {
  id                  String   @id @default(uuid())
  messageId           String
  conversationId      String
  reporterId          String?
  reporterLabel       String
  reason              String
  messageBodySnapshot String
  messageSenderLabel  String
  // "PENDING" (у черзі) | "REVIEWED" (адмін переглянув, MSG+.4.2)
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  moderationLogs ConversationModerationLog[]

  // Список репортів адмін-черги (MSG+.4.2), найновіші/непереглянуті зверху.
  @@index([status, createdAt])
  @@index([conversationId])
}

// Аудит-слід перегляду приватної розмови адміном (MSG+.4.2, рішення
// 03.09.2026): ADMIN НЕ має вільного доступу до всіх розмов — перегляд
// можливий лише через конкретний репорт (`messageReportId`), і КОЖЕН
// такий перегляд логується окремим рядком (не одне поле "хто останній
// переглянув", як `roleChangedByLabel` на `User` — тут потрібна повна
// історія переглядів, а не лише останній). `adminLabel` — текстовий
// знімок "Ім'я (email)" (той самий формат, що `formatActorLabel`,
// `modules/users/service.ts`), `adminId` nullable + `onDelete: SetNull`
// — той самий F.24-патерн: лог перегляду лишається читабельним, навіть
// якщо той адмін пізніше видалить свій акаунт.
model ConversationModerationLog {
  id              String   @id @default(uuid())
  conversationId  String
  messageReportId String?
  adminId         String?
  adminLabel      String
  viewedAt        DateTime @default(now())

  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageReport MessageReport? @relation(fields: [messageReportId], references: [id], onDelete: SetNull)
  admin         User?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageReportId])
}
