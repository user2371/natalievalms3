datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  firstName          String
  lastName           String?
  nickname           String?
  avatarUrl          String?
  about              String?
  homeworkVisible    Boolean   @default(true)
  role               String    @default("USER") // "USER" | "ADMIN"
  // ADMIN+.1 (09.08.2026). Аудит останньої зміни ролі — ХТО (текстовий
  // знімок "Ім'я Прізвище (email)" на момент дії, а НЕ FK на User: якщо
  // того адміна згодом видалять (F.24, реальне видалення акаунта),
  // запис лишається читабельним замість перетворення на "хтось видалений"
  // чи каскадного стирання самого сліду зміни) і КОЛИ. NULL для всіх,
  // чию роль ще ніколи не змінювали вручну через /admin/users (включно з
  // тими, хто отримав ADMIN одразу через prisma/seed.ts).
  roleChangedByLabel String?
  roleChangedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments         Enrollment[]
  progress            Progress[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  pointsLedger        PointsLedger[]
  homeworkSubmissions HomeworkSubmission[]
  certificates        Certificate[]
}

model PendingRegistration {
  // F.26 (27.08.2026). Незавершена реєстрація — юзер ще НЕ підтвердив
  // email кодом, тому реального запису User для нього ще немає.
  // Навмисно ОКРЕМА модель, а не поле на User (User тут в принципі не
  // існує) і навмисно НЕ stateless JWT (як passwordResetToken/
  // emailChangeToken) — бо потрібно рахувати невдалі спроби вводу коду
  // (attempts) і дозволяти "надіслати ще раз", а це вимагає стану, який
  // переживає рестарт сервера/serverless-інстансу (на відміну від
  // in-memory throttle-мапи в lib/auth/rateLimit.ts, тут втрата запису
  // означала б, що юзер, який щойно ввів правильний код, "не існує").
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String?
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Course {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  description      String
  coverImage       String?
  published        Boolean  @default(false)
  introVideoUrl    String?
  introDescription String?
  // Поля майстра/інструктора курсу (задача 3.11, доповнення 24.07.2026 —
  // за прямим проханням користувача). Усі опційні: якщо адмін їх не
  // заповнив, `MasterSection` на лендінгу лишається на статичному фолбеку
  // (той самий "містячий" патерн за наявністю даних, що вже застосований
  // для Hero-опису курсу). Одне поле "майстер" на курс, а не окрема
  // модель `Instructor`, — свідоме спрощення: наразі на сайті один курс з
  // однією авторкою, окрема модель була б передчасною абстракцією.
  masterName       String?
  masterBio        String?
  masterAvatarUrl  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  certificates Certificate[]
}

model Lesson {
  id            String   @id @default(uuid())
  courseId      String
  order         Int
  title         String
  duration      String?
  videoProvider String   @default("YOUTUBE") // "YOUTUBE" | "CUSTOM"
  videoUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  article             Article?
  quiz                Quiz?
  progress            Progress[]
  comments            Comment[]
  homeworkSubmissions HomeworkSubmission[]

  @@index([courseId, order])
}

model Article {
  id          String   @id @default(uuid())
  lessonId    String   @unique
  contentJson String
  updatedAt   DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String   @id @default(uuid())
  lessonId  String   @unique
  createdAt DateTime @default(now())

  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id       String  @id @default(uuid())
  quizId   String
  order    Int
  type     String  @default("TEXT") // "TEXT" | "IMAGE"
  text     String
  imageUrl String?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String  @id @default(uuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  quizScore   Int?
  quizTotal   Int?
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Comment {
  id        String   @id @default(uuid())
  lessonId  String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([lessonId])
  @@index([parentId])
}

model CommentReaction {
  id        String @id @default(uuid())
  commentId String
  userId    String
  type      String // "LIKE" | "DISLIKE"

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String // "LESSON_COMPLETED" | "COURSE_COMPLETED"
  lessonId  String?
  courseId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, amount])
}

model HomeworkSubmission {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  videoUrl  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// `Certificate` (Фаза "Fixes", модуль `modules/certificates`) — реальна
// видача сертифіката, автоматично при завершенні ВСІХ уроків курсу (той
// самий тригер, що вже нараховує +5 балів за курс — `awardCoursePoints`,
// `modules/quizzes/actions.ts` → `submitQuizResultAction`). Один сертифікат
// на пару (userId, courseId) — `@@unique`, повторне завершення (неможливе
// логічно, але про всяк випадок) не плодить дублікати.
// ФАЗА CERT+, задача CERT+.0.1 (08.08.2026). Перший enum у схемі —
// розрізняє системно видані сертифікати (`SYSTEM`, наявна поведінка —
// завжди прив'язані до курсу, рендеряться як стилізований SVG-"папір")
// від власних завантажень користувача (`UPLOADED`, без курсу, з
// реальним фото). Перевірка "яке поле є для якого джерела" — НЕ
// БД-constraint (щоб не ускладнювати міграцію), а в
// `modules/certificates/service.ts`, той самий принцип, що решта
// бізнес-правил проєкту (валідація в сервісному шарі, не в БД).
enum CertificateSource {
  SYSTEM
  UPLOADED
}

model Certificate {
  id        String            @id @default(uuid())
  userId    String
  // ФАЗА CERT+, CERT+.0.1: зроблено НЕобов'язковим — для `UPLOADED`
  // курсу немає. `@@unique([userId, courseId])` нижче НЕ чіпається:
  // у Postgres кілька рядків з `courseId = NULL` не конфліктують між
  // собою (NULL ≠ NULL в unique-індексі), тож кілька
  // `UPLOADED`-сертифікатів одного юзера без курсу вже коректно
  // допустимі без зміни обмеження.
  courseId  String?
  issuedAt  DateTime          @default(now())
  source    CertificateSource @default(SYSTEM)
  /// Довільна назва, яку вводить сам користувач при завантаженні (CERT+.0.5). NULL для `SYSTEM` (там і далі використовується `course.title`).
  title     String?
  /// Cloudinary URL фото. NULL для `SYSTEM` (там рендериться SVG-"папір", не фото).
  imageUrl  String?
  /// Cloudinary `public_id` — потрібен для видалення файлу (CERT+.1.3/IMG+.3.4). NULL для `SYSTEM`.
  imagePublicId String?
  /// ФАЗА IMG+, IMG+.3.3 — метадані обробленого Sharp-pipeline зображення, лише для `UPLOADED`.
  width     Int?
  height    Int?
  sizeBytes Int?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}
