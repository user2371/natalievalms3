generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String?
  firstName           String
  lastName            String?
  nickname            String?
  avatarUrl           String?
  about               String?
  homeworkVisible     Boolean              @default(true)
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  roleChangedByLabel  String?
  roleChangedAt       DateTime?
  certificates        Certificate[]
  comments            Comment[]
  commentReactions    CommentReaction[]
  enrollments         Enrollment[]
  homeworkSubmissions HomeworkSubmission[]
  pointsLedger        PointsLedger[]
  progress            Progress[]
}

model Course {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  description      String
  coverImage       String?
  published        Boolean       @default(false)
  introVideoUrl    String?
  introDescription String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  masterName       String?
  masterBio        String?
  masterAvatarUrl  String?
  certificates     Certificate[]
  enrollments      Enrollment[]
  lessons          Lesson[]
}

model Lesson {
  id                  String               @id @default(uuid())
  courseId            String
  order               Int
  title               String
  duration            String?
  videoProvider       String               @default("YOUTUBE")
  videoUrl            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  article             Article?
  comments            Comment[]
  homeworkSubmissions HomeworkSubmission[]
  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress            Progress[]
  quiz                Quiz?

  @@index([courseId, order])
}

model Article {
  id          String   @id @default(uuid())
  lessonId    String   @unique
  contentJson String
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String     @id @default(uuid())
  lessonId  String     @unique
  createdAt DateTime   @default(now())
  questions Question[]
  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Question {
  id       String   @id @default(uuid())
  quizId   String
  order    Int
  type     String   @default("TEXT")
  text     String
  imageUrl String?
  answers  Answer[]
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  order      Int
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Progress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  quizScore   Int?
  quizTotal   Int?
  completedAt DateTime?
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Comment {
  id        String            @id @default(uuid())
  lessonId  String
  userId    String
  content   String
  createdAt DateTime          @default(now())
  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([lessonId])
}

model CommentReaction {
  id        String  @id @default(uuid())
  commentId String
  userId    String
  type      String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model PointsLedger {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  lessonId  String?
  courseId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, amount])
}

model HomeworkSubmission {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  videoUrl  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id            String            @id @default(uuid())
  userId        String
  courseId      String?
  issuedAt      DateTime          @default(now())
  source        CertificateSource @default(SYSTEM)
  /// Довільна назва, яку вводить сам користувач при завантаженні (CERT+.0.5). NULL для `SYSTEM` (там і далі використовується `course.title`).
  title         String?
  /// Cloudinary URL фото. NULL для `SYSTEM` (там рендериться SVG-"папір", не фото).
  imageUrl      String?
  /// Cloudinary `public_id` — потрібен для видалення файлу (CERT+.1.3/IMG+.3.4). NULL для `SYSTEM`.
  imagePublicId String?
  /// ФАЗА IMG+, IMG+.3.3 — метадані обробленого Sharp-pipeline зображення, лише для `UPLOADED`.
  width         Int?
  height        Int?
  sizeBytes     Int?
  course        Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

enum CertificateSource {
  SYSTEM
  UPLOADED
}
