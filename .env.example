# Локальний PostgreSQL (Docker: див. CLAUDE.md, розділ "База даних та Prisma CLI").
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://natalieva:natalieva@localhost:5432/natalieva_lms?schema=public"
AUTH_SECRET="REDACTED_SECRET"

# Фаза 3+ (04.08.2026): сховище файлів для аватарок — Cloudinary, free tier.
# Дашборд Cloudinary після реєстрації на cloudinary.com показує ці три
# значення одразу на головній сторінці ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Фаза 3+: відправка листів (підтвердження зміни email) — Resend, free tier.
# API-ключ — resend.com/api-keys. RESEND_FROM_EMAIL — адреса відправника;
# без верифікованого власного домену в Resend можна лише слати з
# onboarding@resend.dev і лише на email, яким реєструвались у Resend
# (sandbox-обмеження) — див. ФАЗА 3+, розділ 3+.0.6.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Фаза 3+: базовий URL сайту — потрібен, щоб зібрати посилання
# підтвердження в листі (`${NEXT_PUBLIC_APP_URL}/settings/confirm-email?token=...`).
# Локально — адреса dev-сервера; на проді — реальний домен.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
