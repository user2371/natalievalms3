# ФАЗА PAID+, задача PAID+.4.4 (02.09.2026, за прямим проханням
# користувача) — секрети LiqPay, той самий підхід, що вже
# RESEND_API_KEY/Cloudinary-креденшели: у .env, ніколи в клієнтському
# коді. LIQPAY_PUBLIC_KEY — виняток (потрапляє всередину закодованого
# `data` запиту, це нормально за протоколом LiqPay), LIQPAY_PRIVATE_KEY —
# лишається СУВОРО на сервері (підпис/перевірка вебхука,
# lib/payments/liqpay.ts).
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
